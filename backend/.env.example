DATABASE_URL=sqlite:///./avris.db
SECRET_KEY=your-secret-key-here
RESEND_API_KEY=your-resend-key
FRONTEND_URL=http://localhost:8080

# OpenAI Whisper STT
OPENAI_API_KEY=sk-...
WHISPER_MODEL=whisper-1

# LLM
ANTHROPIC_API_KEY=sk-ant-...
# Идентификатор модели у провайдера — задаётся в окружении, не в репозитории
ANTHROPIC_MODEL=
# Лёгкая модель для вызовов без клинического суждения: разбор речи в поля,
# сжатие разговора, фраза дайджеста, вопросы интервью, ассистент пациента.
# Втрое дешевле, и именно эти вызовы дают объём на пациентских тарифах.
#
# ПУСТО = всё идёт на основной модели. Прежде чем заполнять, прогоните
# гардрейлы ассистента на живых вопросах: красные флаги, просьбы поставить
# диагноз, вопросы про дозировки. Гардрейлы промптовые, а слабая модель
# следует сложным инструкциям хуже.
ANTHROPIC_MODEL_LIGHT=

# Google OAuth — get from https://console.cloud.google.com/apis/credentials
# Add BOTH the localhost URI (for dev) and the Railway URI (for prod) to the
# OAuth client's "Authorized redirect URIs" list. Set this var to whichever
# one matches the env you're running.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# prod: https://avris-production-3e05.up.railway.app/api/auth/google/callback

# Mail.ru OAuth — get from https://oauth.mail.ru/app
MAILRU_CLIENT_ID=
MAILRU_CLIENT_SECRET=
MAILRU_REDIRECT_URI=http://localhost:8000/api/auth/mailru/callback
# prod: https://avris-production-3e05.up.railway.app/api/auth/mailru/callback

# Общий секрет для /api/health/deep — глубокой проверки живости.
# Тот же самый должен лежать в секретах репозитория как HEALTH_TOKEN,
# иначе наблюдатель не сможет спросить про конфигурацию.
# Пусто = эндпоинт закрыт совсем (403), а не открыт всем.
HEALTH_TOKEN=
